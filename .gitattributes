# Flutter et Dart imposent LF ; surtout, le workflow de deploiement web lit
# firebase/firebase.env.example avec un parseur bash qui ne tolerate pas un
# \r residuel dans les valeurs.
* text=auto eol=lf

*.json text eol=lf
*.gradle text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf
*.dart text eol=lf
*.yml text eol=lf
*.env text eol=lf
firebase/firebase.env.example text eol=lf

